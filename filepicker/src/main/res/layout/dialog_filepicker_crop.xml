<?xml version="1.0" encoding="utf-8"?>
<!--
  预览页「编辑」用的全屏弹窗（和预览界面一样是 BasePopupWindow）：
  画布 + 状态栏占位 + 底部操作栏（取消 / 旋转 / 镜像 / 还原 …… 右下绿色确定）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.pichs.filepicker.crop.CropView
        android:id="@+id/crop_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.pichs.xwidget.view.XStatusBarView
        android:id="@+id/status_bar_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#ffffff"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="取消"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btn_rotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="旋转"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/filepicker_ic_crop_rotate" />

        <ImageView
            android:id="@+id/btn_mirror"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="镜像"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/filepicker_ic_crop_mirror" />

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="还原"
            android:textColor="#ffffff"
            android:textSize="15sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 和首页底部「确定」按钮完全同款：XRoundButton + 8dp 圆角 + 按压反馈 -->
        <com.pichs.xwidget.roundview.XRoundButton
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#04AD0C"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="确定"
            android:textColor="#fff"
            android:textSize="15sp"
            app:xp_disabledBackground="#8004AD0C"
            app:xp_disabledTextColor="#80ffffff"
            app:xp_pressedAlpha="0.8"
            app:xp_radius="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
