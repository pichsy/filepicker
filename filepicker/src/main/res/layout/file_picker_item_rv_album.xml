<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_margin="1dp"
    android:background="#121212">

    <!--  高度match_parent 设置1：1宽高图片  -->
    <com.pichs.xwidget.view.XImageView
        android:id="@+id/iv_cover_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--    左上角 红色圆形背景数字-->

    <FrameLayout
        android:id="@+id/cl_select_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_cover_image"
        app:layout_constraintEnd_toEndOf="@+id/iv_cover_image">

        <com.pichs.xwidget.cardview.XCardTextView
            android:id="@+id/tv_select_index"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:textColor="#fff"
            android:textSize="12dp"
            app:xp_borderColor="#fff"
            app:xp_borderWidth="2dp"
            app:xp_radius="60dp" />

    </FrameLayout>

    <!--  右下角是个时长展示  -->
    <com.pichs.xwidget.cardview.XCardTextView
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="2dp"
        android:background="#50000000"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="00:00"
        android:textColor="#c1c1c1"
        android:textSize="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:xp_radius="4dp" />


    <com.pichs.xwidget.cardview.XCardImageView
        android:id="@+id/iv_preview_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:src="@drawable/filepicker_ic_scale_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>