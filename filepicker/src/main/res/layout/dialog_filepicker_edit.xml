<?xml version="1.0" encoding="utf-8"?>
<!--
  预览页「编辑」全屏弹窗（和预览界面同款 BasePopupWindow）。
  结构：画布 + 顶部（取消 / 撤销重做）+ 二级面板 + 底部工具条（画笔/文字/裁剪/马赛克 + 完成）。
  说明：本版先搭"编辑页外壳"，画布目前是裁剪画布；画笔/文字/马赛克的笔迹能力后续接入。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <com.pichs.filepicker.crop.CropView
        android:id="@+id/crop_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部渐变（纯视觉，不拦截触摸） -->
    <View
        android:id="@+id/top_scrim"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/filepicker_edit_top_scrim"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 底部渐变：从下方半透明黑向上过渡到纯透明（不拦截触摸） -->
    <View
        android:id="@+id/bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/filepicker_edit_bottom_scrim"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.pichs.xwidget.view.XStatusBarView
        android:id="@+id/status_bar_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00000000"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 顶部条：取消 + 撤销/重做 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_view">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="取消"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_undo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.35"
            android:contentDescription="撤销"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/filepicker_ic_edit_undo" />

        <ImageView
            android:id="@+id/btn_redo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.35"
            android:contentDescription="重做"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/filepicker_ic_edit_redo" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#ffffff"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 二级面板：随当前工具切换内容（代码里动态填充） -->
    <LinearLayout
        android:id="@+id/secondary_panel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#00000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tool_row" />

    <!-- 底部工具条：画笔 / 文字 / 裁剪 / 马赛克 + 完成 -->
    <LinearLayout
        android:id="@+id/tool_row"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/filepicker_edit_bottom_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/tool_doodle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="画笔"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/filepicker_ic_edit_brush" />

        <ImageView
            android:id="@+id/tool_text"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="文字"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/filepicker_ic_edit_text" />

        <ImageView
            android:id="@+id/tool_crop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="裁剪"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/filepicker_ic_edit_crop" />

        <ImageView
            android:id="@+id/tool_mosaic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="马赛克"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/filepicker_ic_edit_mosaic" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.pichs.xwidget.roundview.XRoundButton
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#04AD0C"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="完成"
            android:textColor="#fff"
            android:textSize="15sp"
            app:xp_disabledBackground="#8004AD0C"
            app:xp_disabledTextColor="#80ffffff"
            app:xp_pressedAlpha="0.8"
            app:xp_radius="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
