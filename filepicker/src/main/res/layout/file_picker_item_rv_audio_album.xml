<?xml version="1.0" encoding="utf-8"?>
<com.pichs.xwidget.view.XConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    app:xp_pressedBackground="#121212">

    <!--  高度match_parent 设置1：1宽高图片  -->
    <com.pichs.xwidget.cardview.XCardImageView
        android:id="@+id/iv_cover_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:xp_radius="6dp" />

    <!--    左上角 红色圆形背景数字-->
    <com.pichs.xwidget.cardview.XCardTextView
        android:id="@+id/tv_select_index"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:textColor="#fff"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:xp_borderColor="#fff"
        app:xp_borderWidth="2dp"
        app:xp_radius="30dp" />


    <com.pichs.xwidget.view.XTextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="title"
        android:textColor="#ffffff"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_info"
        app:layout_constraintEnd_toStartOf="@+id/tv_select_index"
        app:layout_constraintStart_toEndOf="@+id/iv_cover_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!--  右下角是个时长展示  -->
    <com.pichs.xwidget.view.XTextView
        android:id="@+id/tv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="00:00"
        android:textColor="#ffffff"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_cover_image"
        app:layout_constraintTop_toBottomOf="@+id/tv_name" />

</com.pichs.xwidget.view.XConstraintLayout>