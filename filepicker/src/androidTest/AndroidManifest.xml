<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      本库 minSdk = 24，但依赖的 xwidget 声明 minSdk = 26。
      库自身的 manifest 是 library manifest，不受此检查影响；而仪器测试要打成 APK，
      manifest merger 会校验依赖的 minSdk，因此只在测试 APK 里显式覆盖。
      运行设备是 API 31，高于 26，不存在实际风险。
    -->
    <uses-sdk tools:overrideLibrary="com.pichs.xwidget" />
</manifest>
