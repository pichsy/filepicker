<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <com.pichs.xwidget.space.XStatusBarSpace
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.pichs.xwidget.view.XConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#121212">

        <com.pichs.xwidget.view.XTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数据制造"
            android:textColor="#fff"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.pichs.xwidget.view.XConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 生成数量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="每种数量："
                    android:textColor="#fff" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_count"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="如3"
                    android:inputType="number"
                    android:text="3"
                    android:textColor="#fff"
                    android:textColorHint="#888" />
            </LinearLayout>

            <!-- 图片/视频 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="媒体（DCIM/TestData）"
                android:textColor="#E60B4D"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="图片（随机彩色，屏幕宽高）"
                android:textColor="#fff" />

            <CheckBox
                android:id="@+id/cb_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频（点下方按钮选一个复制N份）"
                android:textColor="#fff" />

            <!-- 文档 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="文档（Documents/TestData）"
                android:textColor="#E60B4D"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="txt"
                android:textColor="#fff" />

            <CheckBox
                android:id="@+id/cb_doc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="doc / docx"
                android:textColor="#fff" />

            <CheckBox
                android:id="@+id/cb_xls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="xls / xlsx"
                android:textColor="#fff" />

            <CheckBox
                android:id="@+id/cb_ppt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ppt / pptx"
                android:textColor="#fff" />

            <CheckBox
                android:id="@+id/cb_pdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="pdf"
                android:textColor="#fff" />

            <!-- 音乐 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="音乐（Music/TestData）"
                android:textColor="#E60B4D"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_mp3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="mp3（静音音频帧）"
                android:textColor="#fff" />

            <!-- 压缩包 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="压缩包及其他（Download/TestData）"
                android:textColor="#E60B4D"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_zip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="zip（真实zip容器）"
                android:textColor="#fff" />

            <CheckBox
                android:id="@+id/cb_tar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tar / gz"
                android:textColor="#fff" />

            <CheckBox
                android:id="@+id/cb_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="rar / 7z / iso"
                android:textColor="#fff" />

            <CheckBox
                android:id="@+id/cb_apk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="apk（复制本app安装包）"
                android:textColor="#fff" />

            <!-- 生成按钮 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_generate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:backgroundTint="#E60B4D"
                android:text="开始生成"
                android:textColor="#fff" />

            <!-- 选视频复制按钮 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_pick_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:backgroundTint="#333333"
                android:text="选择一个视频并复制N份"
                android:textAllCaps="false"
                android:textColor="#fff" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
