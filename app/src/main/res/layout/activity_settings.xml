<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：收纳从首页挪出来的调试入口，让首页只留"选什么/选多少 → 开始"。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical">

    <com.pichs.xwidget.view.XConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#121212">

        <com.pichs.xwidget.view.XImageView
            android:id="@+id/iv_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_demo_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.pichs.xwidget.view.XTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="#fff"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.pichs.xwidget.view.XConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.pichs.xwidget.view.XTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="调试工具"
            android:textColor="#9E9E9E"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_data_factory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/demo_btn_secondary_bg"
            android:text="数据制造（批量生成测试文件）"
            android:textAllCaps="false"
            android:textColor="#DDDDDD"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_camera_probe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/demo_btn_secondary_bg"
            android:text="相机 intent 探测（拍照/录像组合方案真机验证）"
            android:textAllCaps="false"
            android:textColor="#DDDDDD"
            android:textSize="14sp" />

        <com.pichs.xwidget.view.XTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="相机 intent 探测用于真机对比「一次打开相机、用户在相机里自选拍照还是录像」的几种候选方案。结论：系统没有这种标准 intent，用 chooser 虽然能给出「摄像机 / 相机」两个选项，但回执是 resultCode=0、data=null、EXTRA_OUTPUT 被无视，结果拿不回来，所以库没有采用。这个页面留着方便以后复测别的 ROM，可以随时删。"
            android:textColor="#777777"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
