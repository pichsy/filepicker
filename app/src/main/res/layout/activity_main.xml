<?xml version="1.0" encoding="utf-8"?>
<!--
  首页：只留"选什么/选多少 → 开始"这条主链路。
  数据制造、相机 intent 探测这类调试入口都挪到右上角的设置页（SettingsActivity）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶栏：标题居中，右上角设置 -->
        <com.pichs.xwidget.view.XConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#121212">

            <com.pichs.xwidget.view.XTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="图库选择"
                android:textColor="#fff"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.pichs.xwidget.view.XImageView
                android:id="@+id/iv_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_demo_settings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </com.pichs.xwidget.view.XConstraintLayout>

        <!-- 表单区：统一 16dp 内边距，标签在上、控件在下 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 只在「规则模式=无」时展示：规则模式下合计上限由规则自动叠加，这个输入不参与 -->
            <LinearLayout
                android:id="@+id/layout_max_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.pichs.xwidget.view.XTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最大选择数量"
                    android:textColor="#9E9E9E"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_max_select_count"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/demo_input_bg"
                    android:gravity="center_vertical"
                    android:hint="0 表示不限"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:text="9"
                    android:textColor="#fff"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.pichs.xwidget.view.XTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="最大文件大小（MB）"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_max_file_size"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/demo_input_bg"
                android:gravity="center_vertical"
                android:hint="如 200，留空表示不限"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#fff"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <com.pichs.xwidget.view.XTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="类型"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />

            <!-- 两排横向滑动，chips 由 MainActivity 用 GridLayoutManager(HORIZONTAL, 2) 填 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never" />

            <com.pichs.xwidget.view.XTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="规则模式"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />

            <!-- 模式 chips：无 / 共存 / 互斥，由 MainActivity 的 initRuleModeList() 填充 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_rule_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never" />

            <!-- 图片数量 + 勾选"强制"：勾上 = 必须正好选这么多（min=max），不勾 = 只当上限 -->
            <!-- 仅规则模式为共存 / 互斥时展示，模式为「无」时由 MainActivity 隐藏 -->
            <LinearLayout
                android:id="@+id/layout_image_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.pichs.xwidget.view.XTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图片数量"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_image_count"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/demo_input_bg"
                    android:gravity="center_vertical"
                    android:hint="空=不限"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#fff"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cb_image_force"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:buttonTint="#FFFFFF"
                    android:text="强制"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 视频数量 + 勾选"强制" -->
            <LinearLayout
                android:id="@+id/layout_video_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.pichs.xwidget.view.XTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频数量"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_video_count"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/demo_input_bg"
                    android:gravity="center_vertical"
                    android:hint="空=不限"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#fff"
                    android:textColorHint="#666666"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cb_video_force"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:buttonTint="#FFFFFF"
                    android:text="强制"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_show_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="#FFFFFF"
                android:text="显示相机入口"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_avatar_crop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="#FFFFFF"
                android:text="头像裁剪（单选 1:1，点图直接进裁剪页）"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_avatar_resizable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#FFFFFF"
                android:text="头像裁剪：允许拖拽改裁剪框大小"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_avatar_free"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#FFFFFF"
                android:text="头像裁剪：自由比例（0=自由，默认 1:1）"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_avatar_unlocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#FFFFFF"
                android:text="头像裁剪：拖拽时不锁比例（可拉变形）"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_avatar_frame_scale"
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="#33FFFFFF"
                android:hint="框大小 0.75（0.05~1）"
                android:inputType="numberDecimal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="0.75"
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_edit_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#FFFFFF"
                android:checked="true"
                android:text="预览页可编辑（画笔/文字/裁剪/马赛克）"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_edit_on_click"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#FFFFFF"
                android:text="点击图片直接编辑（单图，编辑完返回）"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />

            <com.pichs.xwidget.view.XTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="测试快捷入口（不用勾选，直接进对应模式）"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_test_edit_on_click"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/demo_btn_secondary_bg"
                    android:text="点击即编辑"
                    android:textAllCaps="false"
                    android:textColor="#fff"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_test_avatar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/demo_btn_secondary_bg"
                    android:text="头像裁剪"
                    android:textAllCaps="false"
                    android:textColor="#fff"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_test_capture_edit"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/demo_btn_primary_bg"
                    android:text="直接拍照→编辑（无列表）"
                    android:textAllCaps="false"
                    android:textColor="#fff"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_test_capture_video"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/demo_btn_primary_bg"
                    android:text="直接录像（无列表）"
                    android:textAllCaps="false"
                    android:textColor="#fff"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/demo_btn_primary_bg"
                android:text="开始"
                android:textAllCaps="false"
                android:textColor="#fff"
                android:textSize="15sp" />

        </LinearLayout>

        <!--
          选择结果：4 列纵向网格。
          高度用 wrap_content 交给外层 ScrollView 滚 —— 它是嵌在 ScrollView 里的，
          自己不滚（nestedScrollingEnabled=false），否则两层滚动会打架。
        -->
        <com.pichs.xwidget.view.XTextView
            android:id="@+id/tv_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:text="选择结果"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="20dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
